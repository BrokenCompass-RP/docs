# Required whenever PERSISTENCE_BACKEND=postgres and in every production deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Development defaults to filesystem when omitted. Production must use postgres.
PERSISTENCE_BACKEND=postgres

# Optional integration-test database. Tests skip PostgreSQL cases when omitted.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE

# Discord OAuth. Use immutable Discord snowflake IDs for guild and role mappings. IDS=Main role, helper roles.
DISCORD_CLIENT_ID=1550856892799000597
DISCORD_CLIENT_SECRET=1550856892799000597
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_GUILD_ID=1419018618687193242
DISCORD_MODERATOR_ROLE_IDS=1419021558370013254 
DISCORD_DEVELOPER_ROLE_IDS=1419020514218999828,1419088887770513428 
